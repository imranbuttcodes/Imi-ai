# --- LLM Providers ---
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Default Model Selection ---
# Which provider to use by default? (groq, openai, cohere, etc.)
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# Used for grading/evaluating in Self-RAG/CRAG (needs to be fast/cheap)
EVAL_MODEL=llama-3.3-70b-versatile

# Used for generating the final answer in Self-RAG/CRAG (needs to be smart)
GEN_MODEL=llama-3.3-70b-versatile

# --- Embedding Settings ---
# Which embedding model to use? (cohere, openai, huggingface)
EMBEDDING_PROVIDER=cohere
COHERE_API_KEY=your_cohere_api_key_here

# --- RAG Settings ---
# Which retrieval strategy to use? (basic, crag, self_rag)
RAG_STRATEGY=crag
CHROMA_DB_PATH=./data/chroma
RETRIEVAL_K=4
TAVILY_API_KEY=your_tavily_api_key_here

# --- App Settings ---
APP_NAME="Nexus AI"
DEBUG=False

# --- MCP Settings ---
# Comma-separated list of absolute paths the AI is allowed to access
MCP_FILESYSTEM_ALLOWED_DIRS=D:\,C:\Users\ApriZon\Desktop

# --- LangSmith Tracing ---
# Set to 'true' and add your API key to trace all LangGraph/LLM calls
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=ls__your_api_key_here
LANGCHAIN_PROJECT="Nexus-AI"
